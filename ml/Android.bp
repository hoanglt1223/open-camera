package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Model runtime and model assets. Pulled into the app through OpenCamera_ml_defaults because
// the app's static_libs list is generated by gradle-generatebp.
android_library {
    name: "OpenCamera_ml",
    srcs: ["src/main/java/**/*.kt"],
    asset_dirs: ["src/main/assets"],
    manifest: "src/main/AndroidManifest.xml",
    sdk_version: "36",
    min_sdk_version: "26",
    product_specific: true,
    static_libs: [
        "OpenCamera_com.google.ai.edge.litert_litert",
        "OpenCamera_com.google.ai.edge.litert_litert-gpu",
        "OpenCamera_com.google.ai.edge.litert_litert-gpu-api",
        "OpenCamera_com.microsoft.onnxruntime_onnxruntime-android",
        "androidx.preference_preference",
        "kotlin-stdlib",
    ],
}

java_defaults {
    name: "OpenCamera_ml_defaults",
    static_libs: ["OpenCamera_ml"],
}