package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "OpenCamera",
    defaults: ["OpenCamera_ml_defaults"],

    srcs: [
        "src/main/java/**/*.kt",
        ":OpenCamera_profiles_srcs",
        ":OpenCamera_capture_srcs",
        ":OpenCamera_pipeline_srcs",
        ":OpenCamera_vendor-bridge_srcs",
    ],
    resource_dirs: ["src/main/res"],
    asset_dirs: ["src/main/assets"],
    manifest: "src/main/AndroidManifest.xml",

    sdk_version: "36",
    product_specific: true,

    overrides: ["Aperture", "Camera2"],

    use_embedded_native_libs: true,
    jni_libs: [
        "libopencamera_pipeline",
        "libopencamera_looks",
        "libopencamera_ai",
        "libopencamera_retouch",
    ],
    // Models are memory-mapped from the APK.
    aaptflags: [
        // DO NOT EDIT THIS SECTION MANUALLY
        "--version-name",
        "1.0",
        "--version-code",
        "1",
    ],

    required: [
        "OpenCameraFrameworksBaseOverlay",
        "OpenCameraLensLauncher",
        "initial-package-stopped-states-dev.opencamera.app",
        "preinstalled-packages-dev.opencamera.app",
    ],

    static_libs: [
        // DO NOT EDIT THIS SECTION MANUALLY
        "androidx.activity_activity-ktx",
        "androidx.appcompat_appcompat",
        "OpenCamera_androidx.camera_camera-camera2",
        "OpenCamera_androidx.camera_camera-core",
        "OpenCamera_androidx.camera_camera-extensions",
        "OpenCamera_androidx.camera_camera-lifecycle",
        "OpenCamera_androidx.camera_camera-video",
        "OpenCamera_androidx.camera_camera-view",
        "OpenCamera_androidx.camera.viewfinder_viewfinder-core",
        "androidx-constraintlayout_constraintlayout",
        "androidx.core_core-ktx",
        "androidx.exifinterface_exifinterface",
        "androidx.lifecycle_lifecycle-runtime",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "androidx.lifecycle_lifecycle-viewmodel-ktx",
        "OpenCamera_androidx.media3_media3-effect",
        "OpenCamera_androidx.media3_media3-exoplayer",
        "OpenCamera_androidx.media3_media3-transformer",
        "OpenCamera_androidx.media3_media3-ui",
        "androidx.preference_preference",
        "androidx.recyclerview_recyclerview",
        "androidx.tracing_tracing",
        "OpenCamera_com.google.ai.edge.litert_litert",
        "OpenCamera_com.google.ai.edge.litert_litert-gpu",
        "OpenCamera_com.google.ai.edge.litert_litert-gpu-api",
        "com.google.android.material_material",
        "OpenCamera_com.google.zxing_core",
        "OpenCamera_com.microsoft.onnxruntime_onnxruntime-android",
        "OpenCamera_io.coil-kt.coil3_coil",
        "OpenCamera_io.coil-kt.coil3_coil-android",
        "OpenCamera_io.coil-kt.coil3_coil-core-android",
        "OpenCamera_io.coil-kt.coil3_coil-video",
        "OpenCamera_io.github.zxing-cpp_android",
        "kotlin-stdlib",
        "kotlinx_coroutines_guava",
        "OpenCamera_org.opencv_opencv",
    ],

    optional_uses_libs: [
        "androidx.camera.extensions.impl"
    ],

    optimize: {
        optimize: true,
        proguard_flags_files: ["proguard-rules.pro"],
        shrink_resources: true,
    },
}

prebuilt_etc {
    name: "initial-package-stopped-states-dev.opencamera.app",
    product_specific: true,
    sub_dir: "sysconfig",
    src: "initial-package-stopped-states-dev.opencamera.app.xml",
    filename_from_src: true,
}

prebuilt_etc {
    name: "preinstalled-packages-dev.opencamera.app",
    product_specific: true,
    sub_dir: "sysconfig",
    src: "preinstalled-packages-dev.opencamera.app.xml",
    filename_from_src: true,
}
