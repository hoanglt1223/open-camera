<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/colorMatchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/color_match_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/color_match_intro"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/referenceImage"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="#22888888"
                android:contentDescription="@string/color_match_reference"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/sourceImage"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginStart="12dp"
                android:background="#22888888"
                android:contentDescription="@string/color_match_source"
                android:scaleType="centerCrop" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/pickReference"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/color_match_reference" />

            <Button
                android:id="@+id/pickSource"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/color_match_source" />
        </LinearLayout>

        <ImageView
            android:id="@+id/previewImage"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="12dp"
            android:background="#22888888"
            android:contentDescription="@string/color_match_preview"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/previewHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/color_match_hold_to_compare"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <RadioGroup
            android:id="@+id/methodGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/methodReinhard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/color_match_method_fast" />

            <RadioButton
                android:id="@+id/methodHistogram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/color_match_method_histogram" />

            <RadioButton
                android:id="@+id/methodOt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/color_match_method_best" />
        </RadioGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/skinSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/color_match_skin" />

        <TextView
            android:id="@+id/intensityLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/color_match_strength" />

        <SeekBar
            android:id="@+id/intensitySeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="100" />

        <EditText
            android:id="@+id/lookName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints=""
            android:hint="@string/color_match_name_hint"
            android:inputType="text"
            android:maxLength="40" />

        <Button
            android:id="@+id/saveLook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/color_match_save" />

        <Button
            android:id="@+id/applyPhotos"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/color_match_apply_photos" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/exportCube"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/color_match_export" />

            <Button
                android:id="@+id/importCube"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/color_match_import" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodySmall" />
    </LinearLayout>
</ScrollView>
