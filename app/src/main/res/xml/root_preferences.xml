<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/appearance_header">

        <ListPreference
            app:defaultValue="glass"
            app:entries="@array/ui_skin_entries"
            app:entryValues="@array/ui_skin_values"
            app:iconSpaceReserved="false"
            app:key="ui_skin"
            app:title="@string/ui_skin"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreference
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="ui_blur"
            app:summary="@string/ui_blur_summary"
            app:title="@string/ui_blur" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/general_header">

        <SwitchPreference
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="bright_screen"
            app:summary="@string/bright_screen_summary"
            app:title="@string/bright_screen_title" />

        <SwitchPreference
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="save_location"
            app:summary="@string/save_location_summary"
            app:title="@string/save_location_title" />

        <SwitchPreference
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="shutter_sound"
            app:summary="@string/shutter_sound_summary"
            app:title="@string/shutter_sound_title" />

        <SwitchPreference
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="leveler"
            app:summary="@string/leveler_summary"
            app:title="@string/leveler_title" />

        <ListPreference
            app:defaultValue="off"
            app:entries="@array/grid_mode_entries"
            app:entryValues="@array/grid_mode_values"
            app:iconSpaceReserved="false"
            app:key="last_grid_mode"
            app:title="@string/grid_setting_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreference
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="assist_composition_hints"
            app:summary="@string/composition_hints_summary"
            app:title="@string/composition_hints_title" />

        <Preference
            app:fragment="dev.opencamera.app.SettingsActivity$GesturesSettingsFragment"
            app:iconSpaceReserved="false"
            app:title="@string/gestures_title" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/photos_header">

        <ListPreference
            app:defaultValue="minimize_latency"
            app:entries="@array/photo_capture_mode_entries"
            app:entryValues="@array/photo_capture_mode_values"
            app:iconSpaceReserved="false"
            app:key="photo_capture_mode"
            app:title="@string/photo_capture_mode_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="AUTO"
            app:iconSpaceReserved="false"
            app:key="multi_frame_source"
            app:title="@string/image_quality_title" />

        <SwitchPreference
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="enable_zsl"
            app:summary="@string/enable_zsl_summary"
            app:title="@string/enable_zsl_title" />

        <SwitchPreference
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="use_photo_jpeg_ultra_hdr"
            app:summary="@string/use_photo_jpeg_ultra_hdr_summary"
            app:title="@string/use_photo_jpeg_ultra_hdr_title" />

        <SwitchPreference
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="enable_raw_image_capture"
            app:summary="@string/enable_raw_image_capture_summary"
            app:title="@string/enable_raw_image_capture_title" />

        <SwitchPreference
            app:defaultValue="false"
            app:dependency="enable_raw_image_capture"
            app:iconSpaceReserved="false"
            app:key="disable_jpeg_with_raw"
            app:summary="@string/disable_jpeg_with_raw_summary"
            app:title="@string/disable_jpeg_with_raw_title" />

        <SwitchPreference
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="photo_ffc_mirror"
            app:summary="@string/photo_ffc_mirror_summary"
            app:title="@string/photo_ffc_mirror_title" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/looks_header">

        <SeekBarPreference
            android:max="100"
            app:defaultValue="100"
            app:iconSpaceReserved="false"
            app:key="look_intensity"
            app:showSeekBarValue="true"
            app:summary="@string/look_intensity_summary"
            app:title="@string/look_intensity_title" />

        <ListPreference
            app:defaultValue="none"
            app:entries="@array/watermark_template_entries"
            app:entryValues="@array/watermark_template_values"
            app:iconSpaceReserved="false"
            app:key="watermark_template"
            app:title="@string/watermark_template_title"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/video_header">

        <SwitchPreference
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="video_stabilization"
            app:summary="@string/video_stabilization_summary"
            app:title="@string/video_stabilization_title" />

        <ListPreference
            app:defaultValue="off"
            app:entries="@array/video_mirror_mode_entries"
            app:entryValues="@array/video_mirror_mode_values"
            app:iconSpaceReserved="false"
            app:key="video_mirror_mode"
            app:title="@string/video_mirror_mode_title"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/vendor_bridge_header">

        <SwitchPreference
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="vendor_bridge_enabled"
            app:summary="@string/vendor_bridge_enabled_summary"
            app:title="@string/vendor_bridge_enabled_title" />

        <ListPreference
            app:defaultValue="phone"
            app:dependency="vendor_bridge_enabled"
            app:entries="@array/processing_source_entries"
            app:entryValues="@array/processing_source_values"
            app:iconSpaceReserved="false"
            app:key="processing_source_hdr"
            app:title="@string/processing_source_hdr_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="phone"
            app:dependency="vendor_bridge_enabled"
            app:entries="@array/processing_source_entries"
            app:entryValues="@array/processing_source_values"
            app:iconSpaceReserved="false"
            app:key="processing_source_night"
            app:title="@string/processing_source_night_title"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/advanced_header">

        <Preference
            app:fragment="dev.opencamera.app.ai.AiSettingsFragment"
            app:iconSpaceReserved="false"
            app:title="@string/ai_settings_title" />

        <Preference
            app:fragment="dev.opencamera.app.SettingsActivity$ProcessingSettingsFragment"
            app:iconSpaceReserved="false"
            app:title="@string/processing_title" />

        <ListPreference
            app:defaultValue=""
            app:iconSpaceReserved="false"
            app:key="device_profile"
            app:title="@string/device_profile_title" />

        <Preference
            app:iconSpaceReserved="false"
            app:key="export_device_profile"
            app:summary="@string/export_device_profile_summary"
            app:title="@string/export_device_profile_title" />

        <SwitchPreference
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="crash_reports"
            app:summary="@string/crash_reports_summary"
            app:title="@string/crash_reports_title" />

        <Preference
            app:dependency="crash_reports"
            app:iconSpaceReserved="false"
            app:key="share_crash_report"
            app:summary="@string/share_crash_report_summary"
            app:title="@string/share_crash_report_title" />

    </PreferenceCategory>

</PreferenceScreen>
