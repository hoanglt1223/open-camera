package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_shared {
    name: "libopencamera_pipeline",
    srcs: [
        "src/main/cpp/pipeline_jni.cpp",
        "src/main/cpp/mf/align.cpp",
        "src/main/cpp/mf/finish.cpp",
        "src/main/cpp/mf/merge.cpp",
        "src/main/cpp/mf/pipeline.cpp",
        "src/main/cpp/mf/raw.cpp",
        "src/main/cpp/mf/superres.cpp",
        "src/main/cpp/stack/stack.cpp",
    ],
    local_include_dirs: [
        "src/main/cpp/mf",
        "src/main/cpp/stack",
    ],
    cflags: [
        "-O3",
        "-ffast-math",
        "-Wall",
        "-Werror",
    ],
    cppflags: ["-fexceptions"],
    shared_libs: ["liblog"],
    sdk_version: "current",
    stl: "c++_static",
    product_specific: true,
}

cc_library_shared {
    name: "libopencamera_looks",
    srcs: ["src/main/cpp/looks/look_apply.cpp"],
    cflags: [
        "-O3",
        "-Wall",
        "-Werror",
    ],
    shared_libs: ["libjnigraphics"],
    sdk_version: "current",
    stl: "c++_static",
    product_specific: true,
}

cc_library_shared {
    name: "libopencamera_ai",
    srcs: [
        "src/main/cpp/ai/ai_ops.cpp",
        "src/main/cpp/ai/ai_core.cpp",
    ],
    cflags: [
        "-O3",
        "-ffast-math",
        "-Wall",
        "-Werror",
    ],
    cppflags: ["-fexceptions"],
    shared_libs: ["libjnigraphics"],
    sdk_version: "current",
    stl: "c++_static",
    product_specific: true,
}

cc_library_shared {
    name: "libopencamera_retouch",
    srcs: [
        "src/main/cpp/retouch/retouch_jni.cpp",
        "src/main/cpp/retouch/patchmatch.cpp",
        "src/main/cpp/retouch/poisson_blend.cpp",
        "src/main/cpp/retouch/freq_sep.cpp",
        "src/main/cpp/retouch/face_color.cpp",
        "src/main/cpp/retouch/mls_warp.cpp",
        "src/main/cpp/ai/ai_core.cpp",
    ],
    cflags: [
        "-O3",
        "-ffast-math",
        "-Wall",
        "-Werror",
    ],
    cppflags: ["-fexceptions"],
    shared_libs: ["libjnigraphics"],
    sdk_version: "current",
    stl: "c++_static",
    product_specific: true,
}

filegroup {
    name: "OpenCamera_pipeline_srcs",
    srcs: ["src/main/java/**/*.kt"],
}
// LibRaw (LGPL-2.1 / CDDL-1.0, unmodified) as its own replaceable shared library.
license {
    name: "OpenCamera_libraw_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-LGPL-2.1"],
    license_text: ["third_party/LibRaw/LICENSE.LGPL"],
}

