    export_include_dirs: ["third_party/LibRaw"],
    local_include_dirs: ["third_party/LibRaw"],
    cflags: [
        "-O2",
        "-w",
        "-DLIBRAW_LIBRARY_BUILD",
        "-DNO_JASPER",
        "-DNO_JPEG",
        "-DNO_LCMS",
    ],
    cppflags: [
        "-fexceptions",
        "-frtti",
