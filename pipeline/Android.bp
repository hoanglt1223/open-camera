    sdk_version: "current",
    stl: "c++_static",
    product_specific: true,
}

cc_library_shared {
    name: "libopencamera_rawjni",
    srcs: ["src/main/cpp/raw/libraw_jni.cpp"],
    shared_libs: ["libopencamera_libraw"],
    cflags: [
        "-O2",
        "-Wall",
        "-Werror",
    ],
    sdk_version: "current",
    stl: "c++_static",
    product_specific: true,
}
